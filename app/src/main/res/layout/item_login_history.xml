<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/rowContent"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/historyItemUsername"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            tools:text="admin"
            android:textColor="#1C1C1E"
            android:textSize="17sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/historyItemPassword"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/historyItemPassword"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="pass**"
            android:textColor="#8E8E93"
            android:textSize="17sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Divider -->
    <View
        android:id="@+id/historyItemDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="16dp"
        android:background="#C6C6C8"
        app:layout_constraintTop_toBottomOf="@id/rowContent" />

</androidx.constraintlayout.widget.ConstraintLayout>
